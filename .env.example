# Variables de entorno (doc. 03 §6). Sin valores reales: staging y producción usan secrets.enc.yaml (SOPS + age).
# En local, infra/compose/generar-env-local.sh crea las claves de los contenedores en infra/compose/.env.

NODE_ENV=development
TZ=UTC

# PostgreSQL: cada servicio con su rol (doc. 03 §11.1); nunca postgres.
DATABASE_URL=postgres://app_rw:<clave>@127.0.0.1:5432/campo
DATABASE_URL_WORKER=postgres://worker_rw:<clave>@127.0.0.1:5432/campo
DATABASE_URL_MIGRATIONS=postgres://app_migrator:<clave>@127.0.0.1:5432/campo

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_ARCHIVOS=archivos
S3_ACCESS_KEY_APP=
S3_SECRET_KEY_APP=
S3_PRESIGN_TTL_SECONDS=900

TUSD_HOOK_SECRET=
TUS_MAX_SIZE_BYTES=26214400

# Credenciales de push: archivos montados, no valores en variables.
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

GLITCHTIP_DSN=
RATE_LIMIT_LOGIN=5
PAQUETE_MAX_TAREAS=200
SYNC_MAX_EVENTOS_LOTE=500
