# Demo en su VPS. Copie este archivo y llénelo:
#   cp infra/demo/.env.example infra/demo/.env
#   chmod 600 infra/demo/.env
# Claves: solo letras y números (van dentro de una URL; @ : / # ? la rompen).
# Para generar una clave:  openssl rand -hex 24
# No cambie las claves de la base después del primer arranque: quedan fijadas en el volumen.

# ── Sitio ────────────────────────────────────────────────────────────────
# Dominio sin https:// (el mismo del Proxy Host de Nginx Proxy Manager)
DOMINIO=demo.suempresa.pe
# Puerto del VPS que publica el contenedor web (el "Forward Port" del proxy)
PUERTO_WEB=8080

# ── Base de datos (PostgreSQL + PostGIS, dentro de Docker) ───────────────
# Host y puerto dentro de la red de Docker: déjelos así.
DB_HOST=postgres
DB_PORT=5432
# Nombre de la base de datos
DB_NAME=campo

# Clave del superusuario postgres (solo para administrar; la app no la usa)
POSTGRES_PASSWORD=
# Clave del usuario app_migrator (aplica las migraciones)
APP_MIGRATOR_PASSWORD=
# Clave del usuario app_rw (la usa la API)
APP_RW_PASSWORD=
# Clave del usuario worker_rw (la usa el worker)
WORKER_RW_PASSWORD=
# Clave del usuario app_ro (solo lectura, para consultas y reportes)
APP_RO_PASSWORD=

# ── Almacenamiento de fotos (MinIO, dentro de Docker) ────────────────────
S3_ACCESS_KEY_APP=campo-demo
S3_SECRET_KEY_APP=

# ── Sesión y subida de archivos ──────────────────────────────────────────
# Firma de las sesiones (genérela con: openssl rand -hex 32)
BETTER_AUTH_SECRET=
# Secreto interno entre tusd y la API
TUSD_HOOK_SECRET=

# ── Mapas sin conexión (opcional) ────────────────────────────────────────
# Mapa base que el worker recorta para los celulares. Vacío = infra/demo/mapa/base.pmtiles
# (llega a zoom 13). Para zoom 15, la URL https de un build de Protomaps, por ejemplo
# https://build.protomaps.com/AAAAMMDD.pmtiles (vea README, «Mapas sin conexión»).
MAPA_FUENTE=
