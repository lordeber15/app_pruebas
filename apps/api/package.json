    "@fastify/rate-limit": "11.2.2",
    "@fastify/type-provider-zod": "1.0.3",
    "better-auth": "1.7.18",
    "fastify": "5.12.8",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@campo/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
